<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.lab6.HelloController">
    <top>
        <VBox spacing="10">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Каталог игр" />
            <HBox alignment="CENTER_LEFT" spacing="10">
                <TextField fx:id="txtSearch" promptText="Поиск по названию/платформе..." HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="cmbFilterGenre" prefWidth="150" />
                <Button onAction="#onClearFilterClick" text="Сбросить фильтр" />
            </HBox>
        </VBox>
    </top>

    <left>
        <VBox spacing="5">
            <padding>
                <Insets bottom="5" left="10" right="5" top="5" />
            </padding>
            <Label text="Жанры:" />
            <ListView fx:id="listGenres" prefWidth="140" />
        </VBox>
    </left>

    <center>
        <TableView fx:id="tableGames">
            <columns>
                <TableColumn fx:id="colTitle" prefWidth="200" text="Название" />
                <TableColumn fx:id="colGenre" prefWidth="120" text="Жанр" />
                <TableColumn fx:id="colPlatform" prefWidth="130" text="Платформа" />
                <TableColumn fx:id="colRating" prefWidth="90" text="Рейтинг" />
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="10">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
            <GridPane hgap="10" vgap="10">
                <Label text="Название:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtTitle" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Жанр:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <ComboBox fx:id="cmbGenre" prefWidth="150" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                <Label text="Платформа:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtPlatform" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Рейтинг:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <TextField fx:id="txtRating" GridPane.columnIndex="3" GridPane.rowIndex="1" />
            </GridPane>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button onAction="#onAddClick" text="Добавить" />
                <Button onAction="#onEditClick" text="Изменить" />
                <Button onAction="#onDeleteClick" text="Удалить" />
                <Label fx:id="lblCount" style="-fx-font-weight: bold;" text="Найдено записей: 0" />
            </HBox>
        </VBox>
    </bottom>
</BorderPane>