<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.lab7.HelloController">
    <top>
        <VBox>
            <MenuBar>
                <Menu text="Файл">
                    <MenuItem fx:id="miNew" text="Новый" onAction="#onNew"/>
                    <MenuItem fx:id="miOpen" text="Открыть..." onAction="#onOpen"/>
                    <MenuItem fx:id="miSave" text="Сохранить" onAction="#onSave"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Выход" onAction="#onExit"/>
                </Menu>
                <Menu text="Правка">
                    <MenuItem text="Вырезать" onAction="#onCut"/>
                    <MenuItem text="Копировать" onAction="#onCopy"/>
                    <MenuItem text="Вставить" onAction="#onPaste"/>
                </Menu>
                <Menu text="Тема">
                    <MenuItem text="Светлая" onAction="#onLightTheme"/>
                    <MenuItem text="Тёмная" onAction="#onDarkTheme"/>
                </Menu>
                <Menu text="Справка">
                    <MenuItem text="О программе" onAction="#onAbout"/>
                </Menu>
            </MenuBar>
            <ToolBar>
                <Button text="Новый" onAction="#onNew"/>
                <Button text="Открыть" onAction="#onOpen"/>
                <Button text="Сохранить" onAction="#onSave"/>
                <Separator/>
                <Button text="Копировать" onAction="#onCopy"/>
            </ToolBar>
        </VBox>
    </top>
    <center>
        <TextArea fx:id="txtEditor">
            <contextMenu>
                <ContextMenu>
                    <items>
                        <MenuItem text="Вырезать" onAction="#onCut"/>
                        <MenuItem text="Копировать" onAction="#onCopy"/>
                        <MenuItem text="Вставить" onAction="#onPaste"/>
                    </items>
                </ContextMenu>
            </contextMenu>
        </TextArea>
    </center>
    <bottom>
        <HBox style="-fx-padding: 5; -fx-background-color: #e0e0e0;">
            <Label fx:id="lblStatus" text="Готово"/>
        </HBox>
    </bottom>
</BorderPane>